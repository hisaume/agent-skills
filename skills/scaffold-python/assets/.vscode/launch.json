{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug application",
      "type": "debugpy",
      "request": "launch",
      "module": "@@PACKAGE@@",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
